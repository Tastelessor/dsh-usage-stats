    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "jsdom": "^24.0.0",
    "lightningcss": "^1.25.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
